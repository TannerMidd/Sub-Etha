    "lucide-react": "^1.30.0",
    "matrix-encrypt-attachment": "^1.0.3",
    "matrix-js-sdk": "^42.1.0",
    "nitro": "^3.0.260610-beta",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-virtuoso": "^4.18.11",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
