{
    "name": "sub-etha",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=22.13.0"
    },
    "scripts": {
        "dev": "vinext dev",
        "prebuild": "node scripts/apply-security-patches.mjs",
        "build": "vite build",
        "start": "node .output/server/index.mjs",
        "format": "prettier --write . --ignore-unknown",
        "format:check": "prettier --check . --ignore-unknown",
        "check": "npm run format:check && npm run lint && npm test && npm run test:browser",
        "typecheck": "tsc --noEmit",
        "test:unit": "node --import tsx --test tests/*.test.ts",
        "test:browser": "playwright test",
        "test": "npm run typecheck && npm run test:unit && npm run build",
        "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .output --ignore-pattern .vercel",
        "db:generate": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs generate",
        "db:migrate": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
        "postinstall": "node scripts/apply-security-patches.mjs"
    },
    "dependencies": {
        "@neondatabase/serverless": "^1.1.0",
        "clsx": "^2.1.1",
        "dompurify": "^3.4.13",
        "drizzle-orm": "0.45.2",
        "emoji-picker-react": "^4.19.1",
        "ipaddr.js": "2.5.0",
        "lucide-react": "^1.31.0",
        "matrix-encrypt-attachment": "^1.0.3",
        "matrix-js-sdk": "^42.1.0",
        "nitro": "^3.0.260610-beta",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-virtuoso": "^4.18.11",
        "web-push": "^3.6.7"
    },
    "devDependencies": {
        "@eslint/js": "9.39.4",
        "@next/eslint-plugin-next": "16.3.0",
        "@playwright/test": "^1.62.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "22.19.19",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@types/web-push": "^3.6.4",
        "@vitejs/plugin-react": "6.0.5",
        "@vitejs/plugin-rsc": "0.5.34",
        "drizzle-kit": "0.31.10",
        "eslint": "9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "fake-indexeddb": "6.2.5",
        "globals": "16.4.0",
        "prettier": "^3.9.6",
        "react-server-dom-webpack": "19.2.8",
        "sass": "^1.102.0",
        "tsx": "^4.23.12",
        "typescript": "5.9.3",
        "typescript-eslint": "8.67.0",
        "vinext": "1.0.0-beta.5",
        "vite": "8.2.1"
    },
    "type": "module"
}
