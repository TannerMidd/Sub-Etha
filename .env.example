# Server persistence for the Web Push gateway.
#
# Docker Compose (docker compose up) supplies DATABASE_URL itself — no setup
# needed for a fully local deployment. For local development without Docker or
# for production, paste a PostgreSQL connection string here:
#
#   Neon:     postgres://<user>:<password>@<ep-name>.neon.tech/<db>
#   Local PG: postgres://sub_etha:sub_etha@localhost:5432/sub_etha
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Optional driver override. Unset means automatic:
#   *.neon.tech hosts use the Neon HTTP driver; every other host uses the
#   standard PostgreSQL wire-protocol driver (local containers, self-hosted).
#   DATABASE_DRIVER=neon|postgres forces one explicitly.
# DATABASE_DRIVER=

# Web Push (closed-app notifications). A fully local `docker compose up`
# deployment generates and stores these automatically on first start; set them
# here to bring your own.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://sub-etha-matrix.vercel.app

# Optional allowlist of extra Web Push provider hostnames and delivery budgets.
PUSH_ENDPOINT_HOSTS=
PUSH_MAX_SUBSCRIPTIONS=10000
PUSH_REGISTRATION_LIMIT_PER_10M=300
PUSH_TEST_LIMIT_PER_MIN=60
PUSH_NOTIFY_LIMIT_PER_MIN=600
PUSH_DELIVERY_LIMIT_PER_MIN=3000
